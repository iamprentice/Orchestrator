# Anthropic API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Reddit API credentials (optional - enables live Reddit scraping)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ComplaintMiner/1.0

# Output settings
OUTPUT_DIR=./output
MAX_COMPLAINTS=10
MAX_OPPORTUNITIES=5
